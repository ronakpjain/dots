# === Theme (Catppuccin Mocha) ===
theme = Catppuccin Mocha

# === Window padding ===
window-padding-x = 10
window-padding-y = 10

background-opacity = 0.8
background-blur = true

# === Fonts ===
font-family = "Hack Nerd Font Mono"
font-style = "Regular"
font-style-bold = "Bold"
font-style-italic = "Italic"
font-style-bold-italic = "Bold Italic"

font-size = 11.0

# Send Ctrl-M / Ctrl-Shift-M as distinct Ctrl-Enter CSI-u events instead of
# legacy Enter/CR. Pi maps them to model cycling forward/backward.
keybind = ctrl+m=csi:13;5u
keybind = ctrl+shift+m=csi:13;6u
